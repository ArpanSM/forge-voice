# Copy to .env.local for local development. Never commit real values.
# All data is synthetic. No paid provider is required.

# local = fully offline LFM3 LLM; hybrid = LFM3 audio + Groq LLM only.
FORGE_VOICE_PROFILE=local

# LFM3-Audio-2B on the host GPU. In a container use http://host.docker.internal:8082.
LFM3_AUDIO_BASE_URL=http://127.0.0.1:8082
LFM3_AUDIO_MODEL=lfm3-audio-2b
LFM3_TTS_VOICE=female
LFM3_LANG=en

# Hybrid profile only; the sole approved external call.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Self-hosted LiveKit dev server (no Cloud, no TURN, no SIP).
# scripts/demo.sh generates a random secret into .env.local; this file only has placeholders.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=

# Local web app and optional per-call trace file.
FORGE_VOICE_WEB_HOST=127.0.0.1
FORGE_VOICE_WEB_PORT=8000
FORGE_VOICE_TRACE=
