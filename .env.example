# Copy to .env.local for local development. Never commit real values.
# All data is synthetic. No paid provider is required.

# local = fully offline LFM3 LLM; hybrid = LFM3 audio + Groq LLM only.
FORGE_VOICE_PROFILE=local

# LFM3-Audio-2B on the host GPU. The Compose agent overrides this to
# http://host.docker.internal:8082; the host-binary demo uses 127.0.0.1.
LFM3_AUDIO_BASE_URL=http://127.0.0.1:8082
LFM3_AUDIO_MODEL=lfm3-audio-2b
LFM3_TTS_VOICE=female
LFM3_LANG=en

# Hybrid profile only; the sole approved external call.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Self-hosted LiveKit dev server (no Cloud, no TURN, no SIP).
# scripts/prepare_local_env.sh fills a random secret even if you copy this file to
# .env.local; the server receives it through the environment, never argv.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=

# Local Compose image tag; make release TAG=v1 tags a previous version for rollback.
FORGE_VOICE_IMAGE_TAG=local
# Host UID/GID for the non-root containers; use `id -u` and `id -g` if not 1000.
FORGE_VOICE_UID=1000
FORGE_VOICE_GID=1000
# Bump for a schema-changing release; make rollback then restores ./data/backup.
# FORGE_VOICE_SCHEMA_VERSION=2
# Optional rollback overrides. make release writes .release/previous and schema markers.
# FORGE_VOICE_PREVIOUS_TAG=v1
# FORGE_VOICE_RESTORE_BACKUP=1

# Local web app and optional per-call trace file. Compose publishes only 127.0.0.1.
FORGE_VOICE_WEB_HOST=127.0.0.1
FORGE_VOICE_WEB_PORT=8000
FORGE_VOICE_TRACE=

# Local dashboard data. The dashboard seeds a synthetic 30-day set when empty.
FORGE_VOICE_DATA_DIR=data
FORGE_VOICE_DASHBOARD_SEED=1

# Optional free Discord or Telegram webhook for alert summaries. Leave empty to disable.
FORGE_VOICE_ALERT_WEBHOOK=
FORGE_VOICE_TELEGRAM_CHAT_ID=
