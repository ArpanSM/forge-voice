# LiveKit Cloud (free Build plan) — required for the hosted/browser path
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

# LLM_PROVIDER: lfm3 = fully local (default); groq = hybrid (LFM3 STT/TTS + Groq LLM);
# orcarouter = last resort. The hybrid is the demo headline, local is the offline fallback.
LLM_PROVIDER=lfm3
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_API_KEY=
ORCAROUTER_MODEL=tencent/hy4-preview-free
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Optional NVIDIA NIM key (trial). Not used by the voice agent: the tested models were
# 4.9 s or timed out. Keep it for long-context extraction experiments.
NVIDIA_API=

# LFM3 Audio-2B, local (STT + TTS + optional chat); no API key, no per-minute cost
LFM3_AUDIO_BASE_URL=http://127.0.0.1:8082
LFM3_AUDIO_MODEL=lfm3-audio-2b
LFM3_TTS_VOICE=female
LFM3_LANG=en

# Unused in the LFM3 audio path; kept for the optional hosted profile
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Optional phone demo (Twilio trial, no card)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15550100
