# Copy to .env.local for local development. Never commit real values.
# All data is synthetic. No paid provider is required for the first slice.

# Local profile: LFM3-Audio-2B on the host GPU (transport ticket).
LFM3_AUDIO_BASE_URL=http://127.0.0.1:8082
LFM3_MODEL=lfm3-audio-2b

# LLM profile: lfm3 (fully offline) or groq (hybrid; the only approved external call).
LLM_PROVIDER=lfm3
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Self-hosted LiveKit dev server (no Cloud, no TURN, no SIP).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# Local web app and data paths.
WEB_HOST=127.0.0.1
WEB_PORT=8000
FORGE_VOICE_DATA_DIR=data
FORGE_VOICE_RECORDINGS_DIR=recordings
