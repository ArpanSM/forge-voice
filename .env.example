# LiveKit Cloud (free Build plan)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

# Deepgram ($200 credit, no card)
DEEPGRAM_API_KEY=replace-me

# Cartesia (free plan)
CARTESIA_API_KEY=replace-me

# LLM: OrcaRouter or Groq
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_API_KEY=replace-me
ORCAROUTER_MODEL=tencent/hy4-preview-free
GROQ_API_KEY=replace-me
GROQ_MODEL=llama-3.3-70b-versatile

# Optional phone demo (Twilio trial, no card)
TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_PHONE_NUMBER=+15550100
